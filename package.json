{
	"name": "@alerix/material-weather",
	"description": "Material-style weather in your toolbar. Search any city, save multiple locations and switch the active place in one tap.",
	"private": true,
	"version": "2.2.1",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"bump-version": "bun run scripts/bump-version.js",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"postinstall": "wxt prepare",
		"format:fix": "prettier --write ."
	},
	"devDependencies": {
		"@tsconfig/svelte": "^5.0.8",
		"@wxt-dev/module-svelte": "^2.0.4",
		"prettier": "3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.12",
		"svelte-check": "^4.4.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"wxt": "^0.20.19"
	},
	"dependencies": {
		"@alerix/m3-loading-indicator": "^1.0.5",
		"@lucide/svelte": "^0.577.0",
		"@tailwindcss/vite": "^4.2.1",
		"@wxt-dev/storage": "^1.2.8",
		"svelte-spa-router": "^4.0.2",
		"tailwindcss": "^4.2.1"
	}
}
